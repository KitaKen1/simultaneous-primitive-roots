module

public import SimultaneousPrimitiveRoots.Unconditional.Transference.Proof35.RowOps
public import SimultaneousPrimitiveRoots.Unconditional.Transference.Proof35.ReturnFourier
public import Mathlib.Algebra.Ring.Periodic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

/-!
# Lemma 3.10: Fourier reduction of a translation-covariant operator

Source: `verification/stage7-sources/S-02.tex`, lines 964–980 (`[S-02:0964–0980]`).

"Fourier transformation on the finite abelian group consisting of the small residue torus and the
pending residue coordinates diagonalizes these translations. … At any fixed Fourier frequency,
translation and the closure factor contribute `e(σ_i Θ D_ℬ)` for a real `Θ` depending on `𝐝`, the
memory prime list, the frequency, and `θ`, but independent of the variable big active labels."

This file is the abstract form of that step. `Y` is a finite set with an action `sh` of `ℤ` of
period `n` (here: the small residues and the pending residues, translated simultaneously), `X` is
a second finite set (the big active lists). A *covariant* row operator on `Y × X`
(`cleanCovOp`) has coefficients `κ(x, ξ) e(θ Δ(x, ξ))` which do not depend on `y`, and moves `y`
by the integer `Δ(x, ξ)`. Its *fibre operators* (`cleanFibOp`) are the row operators on `X` with
the coefficients `κ(x, ξ) e(Θ Δ(x, ξ))`.

`clean_transfer`: if `‖P₁ ∘ fibre(Θ) ∘ P₂‖ ≤ C` on `L²(X, m_X)` for every real `Θ`, then
`‖P₁ ∘ cov(θ) ∘ P₂‖ ≤ C` on `L²(Y × X, m_Y ⊗ m_X)` for every `sh`-invariant weight `m_Y`, where
`P₁`, `P₂` act on the `X`-variable (`cleanLiftX`; here: the symmetrization of the big lists).

The proof uses the components `G_f(y, x) = ∑_{t < n} e(-f t / n) G(sh_t y, x)`, `f < n`
(`cleanTwist`): they satisfy Parseval's identity `∑_f ‖G_f‖² = n² ‖G‖²` (`cleanTwist_parseval`),
they commute with `P₁`, `P₂`, and the covariant operator acts on the `f`-th component as the fibre
operator with `Θ = θ + f/n` (`cleanTwist_covOp`). The frequencies of the paper are the characters
of the cyclic group generated by the diagonal translation; no other characters are needed.
-/

@[expose] public section

namespace SimultaneousPrimitiveRoots.Unconditional.Transference.Proof35

open scoped BigOperators ComplexConjugate

noncomputable section

/-! ### Exponentials and Parseval's identity on `ℤ/n` -/

theorem clean_expUnit_add (a b : ℝ) : expUnit (a + b) = expUnit a * expUnit b := by
  unfold expUnit
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem clean_expUnit_intCast (m : ℤ) : expUnit (m : ℝ) = 1 := by
  unfold expUnit
  have e : (2 * Real.pi * Complex.I * ((m : ℝ) : ℂ)) = (m : ℂ) * (2 * Real.pi * Complex.I) := by
    push_cast
    ring
  rw [e]
  exact Complex.exp_int_mul_two_pi_mul_I m

theorem clean_conj_expUnit (t : ℝ) : conj (expUnit t) = expUnit (-t) := by
  have h : ∀ s : ℝ, expUnit s = Complex.exp (((2 * Real.pi * s : ℝ) : ℂ) * Complex.I) := by
    intro s
    unfold expUnit
    congr 1
    push_cast
    ring
  rw [h, h, ← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I]
  congr 1
  push_cast
  ring

/-- **Parseval's identity for the characters of `ℤ/n`**:
`∑_{f<n} |∑_{t<n} e(-f t/n) a_t|² = n ∑_{t<n} |a_t|²`. -/
theorem clean_parseval (n : ℕ) (hn : 0 < n) (a : ℕ → ℂ) :
    ∑ f ∈ Finset.range n,
        ‖∑ t ∈ Finset.range n, expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * a t‖ ^ 2 =
      (n : ℝ) * ∑ t ∈ Finset.range n, ‖a t‖ ^ 2 := by
  have hterm : ∀ f ∈ Finset.range n,
      ((‖∑ t ∈ Finset.range n, expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * a t‖ : ℝ) : ℂ) ^ 2 =
        ∑ t ∈ Finset.range n, ∑ t' ∈ Finset.range n,
          (a t * conj (a t')) *
            expUnit ((f : ℝ) / (n : ℝ) * (((t' : ℤ) - (t : ℤ) : ℤ) : ℝ)) := by
    intro f _
    rw [← Complex.mul_conj', map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun t' _ => ?_
    have e : expUnit ((f : ℝ) / (n : ℝ) * (((t' : ℤ) - (t : ℤ) : ℤ) : ℝ)) =
        expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) *
          expUnit (-(-((f : ℝ) / (n : ℝ) * (t' : ℝ)))) := by
      rw [← clean_expUnit_add]
      congr 1
      push_cast
      ring
    rw [map_mul, clean_conj_expUnit, e]
    ring
  have hin : ∀ t ∈ Finset.range n, ∀ t' ∈ Finset.range n,
      ∑ f ∈ Finset.range n,
          (a t * conj (a t')) *
            expUnit ((f : ℝ) / (n : ℝ) * (((t' : ℤ) - (t : ℤ) : ℤ) : ℝ)) =
        if t' = t then (a t * conj (a t')) * (n : ℂ) else 0 := by
    intro t ht t' ht'
    have ht1 := Finset.mem_range.mp ht
    have ht2 := Finset.mem_range.mp ht'
    rw [← Finset.mul_sum, sum_expUnit_range n hn ((t' : ℤ) - (t : ℤ))
      (fun h0 hdvd => h0 (Int.eq_zero_of_abs_lt_dvd hdvd (abs_lt.mpr ⟨by omega, by omega⟩)))]
    by_cases htt : t' = t
    · have h1 : (t' : ℤ) - (t : ℤ) = 0 := by omega
      rw [if_pos h1, if_pos htt]
    · have h1 : ¬((t' : ℤ) - (t : ℤ) = 0) := by omega
      rw [if_neg h1, if_neg htt, mul_zero]
  have hC : ∑ f ∈ Finset.range n,
        ((‖∑ t ∈ Finset.range n, expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * a t‖ : ℝ) : ℂ) ^ 2 =
      (n : ℂ) * ∑ t ∈ Finset.range n, ((‖a t‖ : ℝ) : ℂ) ^ 2 := by
    rw [Finset.sum_congr rfl hterm, Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun t ht => ?_
    have hsingle : ∑ t' ∈ Finset.range n,
          (if t' = t then (a t * conj (a t')) * (n : ℂ) else 0) = a t * conj (a t) * (n : ℂ) :=
      (Finset.sum_eq_single_of_mem
        (f := fun t' => if t' = t then (a t * conj (a t')) * (n : ℂ) else 0) t ht
        (fun t' _ hne => if_neg hne)).trans (if_pos rfl)
    rw [Finset.sum_comm, Finset.sum_congr rfl (hin t ht), hsingle, ← Complex.mul_conj']
    ring
  exact_mod_cast hC

/-- **A sum of a periodic function over a period does not depend on the starting point.** -/
theorem clean_sum_range_shift {M : Type*} [AddCommGroup M] (n : ℕ) (hn : 0 < n) (Φ : ℤ → M)
    (hΦ : ∀ a : ℤ, Φ (a + (n : ℤ)) = Φ a) (Δ : ℤ) :
    ∑ t ∈ Finset.range n, Φ (Δ + (t : ℤ)) = ∑ t ∈ Finset.range n, Φ (t : ℤ) := by
  have hnat : ∀ k : ℕ, ∑ t ∈ Finset.range n, Φ ((k : ℤ) + (t : ℤ)) =
      ∑ t ∈ Finset.range n, Φ (t : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine Finset.sum_congr rfl fun t _ => congrArg Φ ?_
      rw [Nat.cast_zero, zero_add]
    | succ k ih =>
      have h1 := Finset.sum_range_succ (fun t : ℕ => Φ ((k : ℤ) + (t : ℤ))) n
      have h2 := Finset.sum_range_succ' (fun t : ℕ => Φ ((k : ℤ) + (t : ℤ))) n
      have h3 : Φ ((k : ℤ) + ((n : ℕ) : ℤ)) = Φ ((k : ℤ) + ((0 : ℕ) : ℤ)) := by
        rw [Nat.cast_zero, add_zero]
        exact hΦ k
      have h4 : ∑ t ∈ Finset.range n, Φ ((k : ℤ) + ((t + 1 : ℕ) : ℤ)) =
          ∑ t ∈ Finset.range n, Φ ((k : ℤ) + (t : ℤ)) := by
        have h5 := h2.symm.trans h1
        rw [h3] at h5
        exact add_right_cancel h5
      rw [← ih, ← h4]
      refine Finset.sum_congr rfl fun t _ => congrArg Φ ?_
      push_cast
      ring
  have hne : (n : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
  have hk : ((Δ % (n : ℤ)).toNat : ℤ) = Δ % (n : ℤ) :=
    Int.toNat_of_nonneg (Int.emod_nonneg Δ hne)
  rw [← hnat (Δ % (n : ℤ)).toNat]
  refine Finset.sum_congr rfl fun t _ => ?_
  have hper := (show Function.Periodic Φ (n : ℤ) from hΦ).int_mul (Δ / (n : ℤ))
  have e : Δ + (t : ℤ) =
      ((Δ % (n : ℤ)).toNat : ℤ) + (t : ℤ) + Δ / (n : ℤ) * (n : ℤ) := by
    rw [hk, Int.emod_def]
    ring
  rw [e]
  exact hper _

/-! ### Covariant operators and their fibre operators -/

section Transfer

variable {Y X Ξ : Type*} [Fintype Y] [Fintype X] [Fintype Ξ]

/-- **The fibre operator at the frequency `Θ`**: the row operator on `X` with the coefficients
`κ(x, ξ) e(Θ Δ(x, ξ))` and the targets `τ(x, ξ)`. -/
def cleanFibOp (κ : X → Ξ → ℂ) (Δ : X → Ξ → ℤ) (τ : X → Ξ → X) (Θ : ℝ) :
    (X → ℂ) →ₗ[ℂ] (X → ℂ) :=
  rowOp (fun x ξ => κ x ξ * expUnit (Θ * (Δ x ξ : ℝ))) τ

/-- **A translation-covariant row operator on `Y × X`**: the coefficients
`κ(x, ξ) e(θ Δ(x, ξ))` do not depend on `y`, and the transition moves `y` by `Δ(x, ξ)`. -/
def cleanCovOp (sh : ℤ → Y → Y) (κ : X → Ξ → ℂ) (Δ : X → Ξ → ℤ) (τ : X → Ξ → X) (θ : ℝ) :
    (Y × X → ℂ) →ₗ[ℂ] (Y × X → ℂ) :=
  rowOp (fun p ξ => κ p.2 ξ * expUnit (θ * (Δ p.2 ξ : ℝ)))
    (fun p ξ => (sh (Δ p.2 ξ) p.1, τ p.2 ξ))

/-- An operator on the functions of `x`, applied for every fixed `y`. -/
def cleanLiftX (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (G : Y × X → ℂ) : Y × X → ℂ :=
  fun p => P (fun x => G (p.1, x)) p.2

/-- **The component of the frequency `f`**: `G_f(y, x) = ∑_{t<n} e(-f t/n) G(sh_t y, x)`. -/
def cleanTwist (sh : ℤ → Y → Y) (n f : ℕ) (H : Y × X → ℂ) : Y × X → ℂ :=
  fun p => ∑ t ∈ Finset.range n,
    expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * H (sh (t : ℤ) p.1, p.2)

/-- A translation as a bijection. -/
def cleanShEquiv (sh : ℤ → Y → Y) (h0 : ∀ y, sh 0 y = y)
    (hadd : ∀ a b y, sh (a + b) y = sh a (sh b y)) (a : ℤ) : Y ≃ Y where
  toFun := sh a
  invFun := sh (-a)
  left_inv y := by rw [← hadd, neg_add_cancel, h0]
  right_inv y := by rw [← hadd, add_neg_cancel, h0]

/-- The norm of `L²(Y × X, m_Y ⊗ m_X)` as an integral over `y` of the norms of the fibres. -/
theorem clean_wNormSq_prod (mY : Y → ℝ) (mX : X → ℝ) (H : Y × X → ℂ) :
    wNormSq (fun p : Y × X => mY p.1 * mX p.2) H =
      ∑ y, mY y * wNormSq mX (fun x => H (y, x)) := by
  have h1 : wNormSq (fun p : Y × X => mY p.1 * mX p.2) H =
      ∑ p : Y × X, mY p.1 * mX p.2 * ‖H p‖ ^ 2 := rfl
  have h2 : ∀ y, mY y * wNormSq mX (fun x => H (y, x)) =
      ∑ x, mY y * mX x * ‖H (y, x)‖ ^ 2 := by
    intro y
    have h3 : wNormSq mX (fun x => H (y, x)) = ∑ x, mX x * ‖H (y, x)‖ ^ 2 := rfl
    rw [h3, Finset.mul_sum]
    exact Finset.sum_congr rfl fun x _ => (mul_assoc _ _ _).symm
  rw [h1, Fintype.sum_prod_type]
  exact Finset.sum_congr rfl fun y _ => (h2 y).symm

omit [Fintype Y] [Fintype X] in
/-- The components commute with an operator acting on the `x`-variable. -/
theorem cleanTwist_liftX (sh : ℤ → Y → Y) (n f : ℕ) (P : (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (H : Y × X → ℂ) :
    cleanTwist sh n f (cleanLiftX P H) = cleanLiftX P (cleanTwist sh n f H) := by
  funext p
  have h : (fun x => cleanTwist sh n f H (p.1, x)) =
      ∑ t ∈ Finset.range n,
        expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) • (fun x => H (sh (t : ℤ) p.1, x)) := by
    funext x
    rw [Finset.sum_apply]
    rfl
  show ∑ t ∈ Finset.range n, expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) *
      P (fun x => H (sh (t : ℤ) p.1, x)) p.2 = P (fun x => cleanTwist sh n f H (p.1, x)) p.2
  rw [h, map_sum, Finset.sum_apply]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [map_smul]
  rfl

omit [Fintype Y] [Fintype X] in
/-- **On the component of the frequency `f` the covariant operator acts as the fibre operator
with `Θ = θ + f/n`** [S-02:0971–0980]. -/
theorem cleanTwist_covOp (sh : ℤ → Y → Y) (hadd : ∀ a b y, sh (a + b) y = sh a (sh b y))
    (n : ℕ) (hn : 0 < n) (hper : ∀ y, sh (n : ℤ) y = y) (κ : X → Ξ → ℂ) (Δ : X → Ξ → ℤ)
    (τ : X → Ξ → X) (θ : ℝ) (f : ℕ) (H : Y × X → ℂ) (y : Y) (x : X) :
    cleanTwist sh n f (cleanCovOp sh κ Δ τ θ H) (y, x) =
      cleanFibOp κ Δ τ (θ + (f : ℝ) / (n : ℝ)) (fun x' => cleanTwist sh n f H (y, x')) x := by
  have hne : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  have hfn : (f : ℝ) / (n : ℝ) * (n : ℝ) = (f : ℝ) := div_mul_cancel₀ _ hne
  show ∑ t ∈ Finset.range n, expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) *
        ∑ ξ, κ x ξ * expUnit (θ * (Δ x ξ : ℝ)) * H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ) =
      ∑ ξ, κ x ξ * expUnit ((θ + (f : ℝ) / (n : ℝ)) * (Δ x ξ : ℝ)) *
        ∑ t ∈ Finset.range n,
          expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * H (sh (t : ℤ) y, τ x ξ)
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ξ _ => ?_
  have hshift : ∑ t ∈ Finset.range n,
        expUnit (-((f : ℝ) / (n : ℝ) * ((Δ x ξ + (t : ℤ) : ℤ) : ℝ))) *
          H (sh (Δ x ξ + (t : ℤ)) y, τ x ξ) =
      ∑ t ∈ Finset.range n,
        expUnit (-((f : ℝ) / (n : ℝ) * (((t : ℤ) : ℤ) : ℝ))) * H (sh (t : ℤ) y, τ x ξ) := by
    refine clean_sum_range_shift n hn
      (fun a : ℤ => expUnit (-((f : ℝ) / (n : ℝ) * (a : ℝ))) * H (sh a y, τ x ξ)) ?_ (Δ x ξ)
    intro a
    have e : -((f : ℝ) / (n : ℝ) * ((a + (n : ℤ) : ℤ) : ℝ)) =
        -((f : ℝ) / (n : ℝ) * (a : ℝ)) + ((-(f : ℤ) : ℤ) : ℝ) := by
      push_cast
      rw [mul_add, hfn]
      ring
    show expUnit (-((f : ℝ) / (n : ℝ) * ((a + (n : ℤ) : ℤ) : ℝ))) *
        H (sh (a + (n : ℤ)) y, τ x ξ) =
      expUnit (-((f : ℝ) / (n : ℝ) * (a : ℝ))) * H (sh a y, τ x ξ)
    rw [e, clean_expUnit_add, clean_expUnit_intCast, mul_one, hadd, hper]
  have hL : ∀ t ∈ Finset.range n,
      expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) *
          (κ x ξ * expUnit (θ * (Δ x ξ : ℝ)) * H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ)) =
        κ x ξ * expUnit ((θ + (f : ℝ) / (n : ℝ)) * (Δ x ξ : ℝ)) *
          (expUnit (-((f : ℝ) / (n : ℝ) * ((Δ x ξ + (t : ℤ) : ℤ) : ℝ))) *
            H (sh (Δ x ξ + (t : ℤ)) y, τ x ξ)) := by
    intro t _
    have e1 : expUnit ((θ + (f : ℝ) / (n : ℝ)) * (Δ x ξ : ℝ)) *
          expUnit (-((f : ℝ) / (n : ℝ) * ((Δ x ξ + (t : ℤ) : ℤ) : ℝ))) =
        expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * expUnit (θ * (Δ x ξ : ℝ)) := by
      rw [← clean_expUnit_add, ← clean_expUnit_add]
      congr 1
      push_cast
      ring
    rw [hadd]
    calc expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) *
          (κ x ξ * expUnit (θ * (Δ x ξ : ℝ)) * H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ))
        = κ x ξ * (expUnit (-((f : ℝ) / (n : ℝ) * (t : ℝ))) * expUnit (θ * (Δ x ξ : ℝ))) *
            H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ) := by ring
      _ = κ x ξ * (expUnit ((θ + (f : ℝ) / (n : ℝ)) * (Δ x ξ : ℝ)) *
            expUnit (-((f : ℝ) / (n : ℝ) * ((Δ x ξ + (t : ℤ) : ℤ) : ℝ)))) *
            H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ) := by rw [e1]
      _ = κ x ξ * expUnit ((θ + (f : ℝ) / (n : ℝ)) * (Δ x ξ : ℝ)) *
          (expUnit (-((f : ℝ) / (n : ℝ) * ((Δ x ξ + (t : ℤ) : ℤ) : ℝ))) *
            H (sh (Δ x ξ) (sh (t : ℤ) y), τ x ξ)) := by ring
  rw [Finset.sum_congr rfl hL, ← Finset.mul_sum, hshift, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [Int.cast_natCast]

/-- **Parseval's identity for the components**: `∑_{f<n} ‖G_f‖² = n² ‖G‖²` for a weight
`m_Y ⊗ m_X` whose first factor is invariant under the translations. -/
theorem cleanTwist_parseval (sh : ℤ → Y → Y) (h0 : ∀ y, sh 0 y = y)
    (hadd : ∀ a b y, sh (a + b) y = sh a (sh b y)) (n : ℕ) (hn : 0 < n) (mY : Y → ℝ)
    (hinv : ∀ a y, mY (sh a y) = mY y) (mX : X → ℝ) (H : Y × X → ℂ) :
    ∑ f ∈ Finset.range n, wNormSq (fun p : Y × X => mY p.1 * mX p.2) (cleanTwist sh n f H) =
      (n : ℝ) ^ 2 * wNormSq (fun p : Y × X => mY p.1 * mX p.2) H := by
  have hw : ∀ F : Y × X → ℂ, wNormSq (fun p : Y × X => mY p.1 * mX p.2) F =
      ∑ p : Y × X, mY p.1 * mX p.2 * ‖F p‖ ^ 2 := fun F => rfl
  have hp : ∀ p : Y × X,
      ∑ f ∈ Finset.range n, mY p.1 * mX p.2 * ‖cleanTwist sh n f H p‖ ^ 2 =
        (n : ℝ) * ∑ t ∈ Finset.range n, mY p.1 * mX p.2 * ‖H (sh (t : ℤ) p.1, p.2)‖ ^ 2 := by
    intro p
    have h := clean_parseval n hn (fun t : ℕ => H (sh (t : ℤ) p.1, p.2))
    rw [← Finset.mul_sum, ← Finset.mul_sum]
    calc mY p.1 * mX p.2 * ∑ f ∈ Finset.range n, ‖cleanTwist sh n f H p‖ ^ 2
        = mY p.1 * mX p.2 *
            ((n : ℝ) * ∑ t ∈ Finset.range n, ‖H (sh (t : ℤ) p.1, p.2)‖ ^ 2) :=
          congrArg (fun z => mY p.1 * mX p.2 * z) h
      _ = (n : ℝ) * (mY p.1 * mX p.2 * ∑ t ∈ Finset.range n, ‖H (sh (t : ℤ) p.1, p.2)‖ ^ 2) := by
          ring
  have ht : ∀ t ∈ Finset.range n,
      ∑ p : Y × X, mY p.1 * mX p.2 * ‖H (sh (t : ℤ) p.1, p.2)‖ ^ 2 =
        ∑ p : Y × X, mY p.1 * mX p.2 * ‖H p‖ ^ 2 := by
    intro t _
    refine (Finset.sum_congr rfl fun p _ => ?_).trans
      (Equiv.sum_comp ((cleanShEquiv sh h0 hadd (t : ℤ)).prodCongr (Equiv.refl X))
        (fun p : Y × X => mY p.1 * mX p.2 * ‖H p‖ ^ 2))
    obtain ⟨y, x⟩ := p
    show mY y * mX x * ‖H (sh (t : ℤ) y, x)‖ ^ 2 =
      mY (sh (t : ℤ) y) * mX x * ‖H (sh (t : ℤ) y, x)‖ ^ 2
    rw [hinv]
  simp only [hw]
  rw [Finset.sum_comm, Finset.sum_congr rfl fun p _ => hp p, ← Finset.mul_sum, Finset.sum_comm,
    Finset.sum_congr rfl ht, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  ring

/-- **Fourier reduction** [S-02:0964–0980]: if every fibre operator, composed with `P₁` and `P₂`,
has norm at most `C` on `L²(X, m_X)`, then the covariant operator, composed with `P₁` and `P₂` in
the `x`-variable, has norm at most `C` on `L²(Y × X, m_Y ⊗ m_X)`. -/
theorem clean_transfer (sh : ℤ → Y → Y) (h0 : ∀ y, sh 0 y = y)
    (hadd : ∀ a b y, sh (a + b) y = sh a (sh b y)) (n : ℕ) (hn : 0 < n)
    (hper : ∀ y, sh (n : ℤ) y = y) (mY : Y → ℝ) (hmY : ∀ y, 0 ≤ mY y)
    (hinv : ∀ a y, mY (sh a y) = mY y) (mX : X → ℝ) (hmX : ∀ x, 0 ≤ mX x)
    (κ : X → Ξ → ℂ) (Δ : X → Ξ → ℤ) (τ : X → Ξ → X)
    (P₁ P₂ : (X → ℂ) →ₗ[ℂ] (X → ℂ)) {C : ℝ} (hC : 0 ≤ C)
    (hfib : ∀ (Θ : ℝ) (g : X → ℂ),
      wNorm mX (P₁ (cleanFibOp κ Δ τ Θ (P₂ g))) ≤ C * wNorm mX g)
    (θ : ℝ) (G : Y × X → ℂ) :
    wNorm (fun p : Y × X => mY p.1 * mX p.2)
        (cleanLiftX P₁ (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G))) ≤
      C * wNorm (fun p : Y × X => mY p.1 * mX p.2) G := by
  refine wNorm_le_of_wNormSq_le hC ?_
  have hnpos : (0 : ℝ) < (n : ℝ) ^ 2 := pow_pos (Nat.cast_pos.mpr hn) 2
  have hf : ∀ f ∈ Finset.range n,
      wNormSq (fun p : Y × X => mY p.1 * mX p.2)
          (cleanTwist sh n f (cleanLiftX P₁ (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G)))) ≤
        C ^ 2 * wNormSq (fun p : Y × X => mY p.1 * mX p.2) (cleanTwist sh n f G) := by
    intro f _
    rw [clean_wNormSq_prod, clean_wNormSq_prod, Finset.mul_sum]
    refine Finset.sum_le_sum fun y _ => ?_
    have h2 : (fun x' => cleanTwist sh n f (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G)) (y, x')) =
        cleanFibOp κ Δ τ (θ + (f : ℝ) / (n : ℝ))
          (P₂ (fun x => cleanTwist sh n f G (y, x))) := by
      funext x'
      rw [cleanTwist_covOp sh hadd n hn hper κ Δ τ θ f (cleanLiftX P₂ G) y x', cleanTwist_liftX]
      rfl
    have hfun : (fun x => cleanTwist sh n f
          (cleanLiftX P₁ (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G))) (y, x)) =
        P₁ (cleanFibOp κ Δ τ (θ + (f : ℝ) / (n : ℝ))
          (P₂ (fun x => cleanTwist sh n f G (y, x)))) := by
      funext x
      rw [cleanTwist_liftX]
      show P₁ (fun x' =>
        cleanTwist sh n f (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G)) (y, x')) x = _
      rw [h2]
    have h := hfib (θ + (f : ℝ) / (n : ℝ)) (fun x => cleanTwist sh n f G (y, x))
    have hsq : wNormSq mX (P₁ (cleanFibOp κ Δ τ (θ + (f : ℝ) / (n : ℝ))
          (P₂ (fun x => cleanTwist sh n f G (y, x))))) ≤
        C ^ 2 * wNormSq mX (fun x => cleanTwist sh n f G (y, x)) := by
      rw [← wNorm_sq hmX, ← wNorm_sq hmX, ← mul_pow]
      exact pow_le_pow_left₀ (wNorm_nonneg _ _) h 2
    rw [hfun]
    calc mY y * wNormSq mX (P₁ (cleanFibOp κ Δ τ (θ + (f : ℝ) / (n : ℝ))
          (P₂ (fun x => cleanTwist sh n f G (y, x)))))
        ≤ mY y * (C ^ 2 * wNormSq mX (fun x => cleanTwist sh n f G (y, x))) :=
          mul_le_mul_of_nonneg_left hsq (hmY y)
      _ = C ^ 2 * (mY y * wNormSq mX (fun x => cleanTwist sh n f G (y, x))) := by ring
  have hP1 := cleanTwist_parseval sh h0 hadd n hn mY hinv mX
    (cleanLiftX P₁ (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G)))
  have hP2 := cleanTwist_parseval sh h0 hadd n hn mY hinv mX G
  have hsum := Finset.sum_le_sum hf
  rw [hP1, ← Finset.mul_sum, hP2] at hsum
  have h3 : (n : ℝ) ^ 2 * wNormSq (fun p : Y × X => mY p.1 * mX p.2)
        (cleanLiftX P₁ (cleanCovOp sh κ Δ τ θ (cleanLiftX P₂ G))) ≤
      (n : ℝ) ^ 2 * (C ^ 2 * wNormSq (fun p : Y × X => mY p.1 * mX p.2) G) :=
    hsum.trans (le_of_eq (mul_left_comm _ _ _))
  exact le_of_mul_le_mul_left h3 hnpos

end Transfer

end

end SimultaneousPrimitiveRoots.Unconditional.Transference.Proof35
